APP_NAME="License Server"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://license.katresnanku.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# -----------------------------------------------------------------------------
# Reverse Proxy & Network Hardening
# -----------------------------------------------------------------------------
# Trusted reverse proxies (e.g. * for Cloudflare / cPanel Apache reverse proxy)
TRUSTED_PROXIES=*

# -----------------------------------------------------------------------------
# Central License Server Cryptographic Configuration
# -----------------------------------------------------------------------------
# Base64-encoded Ed25519 private key (64-byte secret key or 32-byte seed).
# MANDATORY in production. Generate using: php artisan license:generate-keypair
# Never commit production private keys to version control.
ED25519_PRIVATE_KEY=

# Base64-encoded Ed25519 public key (32 bytes).
# OPTIONAL when derivable from ED25519_PRIVATE_KEY. If provided, must match derived key.
ED25519_PUBLIC_KEY=

# Active Key Identifier (kid) for token signing and verification (e.g. cls-ed25519-2026-v1).
ED25519_KEY_ID=cls-ed25519-2026-v1

# Token TTL in seconds (default: 604800 = 7 days).
LICENSE_TOKEN_TTL=604800

# Authoritative token issuer domain / URL (Must match APP_URL).
LICENSE_ISSUER=license.katresnanku.com

# Rolling refresh threshold percentage (0.50 = 50% remaining TTL).
LICENSE_ROLLING_REFRESH_THRESHOLD=0.50

# Offline clock skew tolerance in seconds (default: 60).
LICENSE_OFFLINE_CLOCK_SKEW_SECONDS=60
